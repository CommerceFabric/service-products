    "https": {
      "commandName": "Project",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "COMMERCEFABRIC_PRODUCTSERVICE_DB_HOST": "localhost",
        "COMMERCEFABRIC_PRODUCTSERVICE_DB_PORT": "3306",
        "COMMERCEFABRIC_PRODUCTSERVICE_DB_NAME": "productDB",
        "COMMERCEFABRIC_PRODUCTSERVICE_DB_USER": "root",
