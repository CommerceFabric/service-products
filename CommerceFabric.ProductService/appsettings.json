{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "host=$COMMERCEFABRIC_PRODUCTSERVICE_DB_HOST;port=$COMMERCEFABRIC_PRODUCTSERVICE_DB_PORT;database=$COMMERCEFABRIC_PRODUCTSERVICE_DB_NAME;user=$COMMERCEFABRIC_PRODUCTSERVICE_DB_USER;password=$COMMERCEFABRIC_PRODUCTSERVICE_DB_PASSWORD" // replaced with value in User Secrets in dev, or environment variable in production
  },
}