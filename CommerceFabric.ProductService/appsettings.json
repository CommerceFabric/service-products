{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "host=$COMMERCEFABRIC_PRODUCTSERVICE_DB_HOST;port=$COMMERCEFABRIC_PRODUCTSERVICE_DB_PORT;database=$COMMERCEFABRIC_PRODUCTSERVICE_DB_NAME;user=$COMMERCEFABRIC_PRODUCTSERVICE_DB_USER;password=$COMMERCEFABRIC_PRODUCTSERVICE_DB_PASSWORD" // replaced with value in User Secrets in dev, or environment variables in production
  },
  "ProductsServiceBus": {
    "ConnectionString": "$SERVICEBUS_CONNECTION_STRING", // replaced with value in User Secrets in dev, or infra-platform's CI/CD GitHub Actions secrets in production
    "ProductUpdateTopic": "products.updates",
    "ProductDeleteTopic": "products.deletes"
  }
}